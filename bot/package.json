{
  "name": "deskbuddies-music-bot",
  "private": true,
  "version": "0.1.0",
  "description": "Jockie-style music bot for the DeskBuddies Discord server — separate always-on process, same Discord Application as the games app's membership-check bot.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "register-commands": "tsx src/register-commands.ts",
    "lint": "oxlint src"
  },
  "dependencies": {
    "@discordjs/voice": "^0.18.0",
    "@supabase/supabase-js": "^2.112.1",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "libsodium-wrappers": "^0.7.15",
    "prism-media": "^1.3.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxlint": "^1.75.0",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2"
  }
}
