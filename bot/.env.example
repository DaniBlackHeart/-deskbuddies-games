# ---- Discord ----
# Same Discord Application that already has the Bot used by verify-membership
# in the frontend/supabase project. Add the bot scope's Voice/Guilds intents
# in the Developer Portal before running this bot (see SETUP.md).
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Optional: set this during development to register slash commands to a single
# guild instantly (global registration can take up to an hour to propagate).
DISCORD_DEV_GUILD_ID=

# ---- Supabase (same project as the games app) ----
# Service-role key only — never the anon key, never exposed to a browser.
# This process is a trusted backend, same trust level as the Edge Functions.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Spotify (optional — only needed to resolve open.spotify.com links) ----
# Client Credentials flow, no user login involved. Free, from
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ---- Playback ----
# Absolute path to a yt-dlp binary. On the recommended Oracle Cloud Ubuntu
# host, `pip install -U yt-dlp` puts it on PATH, so "yt-dlp" is usually fine.
YTDLP_PATH=yt-dlp
# Absolute path to ffmpeg. `apt install ffmpeg` puts it on PATH.
FFMPEG_PATH=ffmpeg

# Default volume (0-2, 1 = 100%)
DEFAULT_VOLUME=0.5
